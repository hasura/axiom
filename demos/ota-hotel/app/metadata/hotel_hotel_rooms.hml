---
kind: ObjectType
version: v1
definition:
  name: hotel_hotel_rooms
  description: "Object type for hotel.hotel_rooms. Description: Room inventory for
    each hotel"
  fields:
    - name: base_price
      type: bigdecimal!
    - name: capacity
      type: int_32!
    - name: created_at
      type: timestamp
    - name: hotel_id
      type: int_32!
    - name: room_id
      type: int_32!
    - name: room_type
      type: string!
    - name: updated_at
      type: timestamp
  graphql:
    typeName: hotel_hotel_rooms
    inputTypeName: hotel_hotel_rooms_input
  dataConnectorTypeMapping:
    - dataConnectorName: pg
      dataConnectorObjectType: hotel.hotel_rooms

---
kind: TypePermissions
version: v1
definition:
  typeName: hotel_hotel_rooms
  permissions:
    - role: admin
      output:
        allowedFields:
          - base_price
          - capacity
          - created_at
          - hotel_id
          - room_id
          - room_type
          - updated_at

---
kind: BooleanExpressionType
version: v1
definition:
  name: hotel_hotel_rooms_bool_exp
  operand:
    object:
      type: hotel_hotel_rooms
      comparableFields:
        - fieldName: base_price
          booleanExpressionType: decimal_bool_exp
        - fieldName: capacity
          booleanExpressionType: integer_bool_exp
        - fieldName: created_at
          booleanExpressionType: timestamp_without_time_zone_bool_exp
        - fieldName: hotel_id
          booleanExpressionType: integer_bool_exp
        - fieldName: room_id
          booleanExpressionType: integer_bool_exp
        - fieldName: room_type
          booleanExpressionType: character_varying_bool_exp
        - fieldName: updated_at
          booleanExpressionType: timestamp_without_time_zone_bool_exp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: hotel_hotel_rooms_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: hotel_hotel_rooms_agg_exp
  operand:
    object:
      aggregatedType: hotel_hotel_rooms
      aggregatableFields:
        - fieldName: base_price
          aggregateExpression: decimal_agg_exp
        - fieldName: capacity
          aggregateExpression: integer_agg_exp
        - fieldName: created_at
          aggregateExpression: timestamp_without_time_zone_agg_exp
        - fieldName: hotel_id
          aggregateExpression: integer_agg_exp
        - fieldName: room_id
          aggregateExpression: integer_agg_exp
        - fieldName: room_type
          aggregateExpression: character_varying_agg_exp
        - fieldName: updated_at
          aggregateExpression: timestamp_without_time_zone_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: hotel_hotel_rooms_agg_exp

---
kind: OrderByExpression
version: v1
definition:
  name: hotel_hotel_rooms_order_by_exp
  operand:
    object:
      orderedType: hotel_hotel_rooms
      orderableFields:
        - fieldName: base_price
          orderByExpression: bigdecimal_order_by_exp
        - fieldName: capacity
          orderByExpression: int_32_order_by_exp
        - fieldName: created_at
          orderByExpression: timestamp_order_by_exp
        - fieldName: hotel_id
          orderByExpression: int_32_order_by_exp
        - fieldName: room_id
          orderByExpression: int_32_order_by_exp
        - fieldName: room_type
          orderByExpression: string_order_by_exp
        - fieldName: updated_at
          orderByExpression: timestamp_order_by_exp
      orderableRelationships: []
  graphql:
    expressionTypeName: hotel_hotel_rooms_order_by_exp

---
kind: Model
version: v2
definition:
  name: hotel_hotel_rooms
  objectType: hotel_hotel_rooms
  source:
    dataConnectorName: pg
    collection: hotel.hotel_rooms
  filterExpressionType: hotel_hotel_rooms_bool_exp
  aggregateExpression: hotel_hotel_rooms_agg_exp
  orderByExpression: hotel_hotel_rooms_order_by_exp
  graphql:
    selectMany:
      queryRootField: hotel_hotel_rooms
      subscription:
        rootField: hotel_hotel_rooms
    selectUniques:
      - queryRootField: hotel_hotel_rooms_by_room_id
        uniqueIdentifier:
          - room_id
        subscription:
          rootField: hotel_hotel_rooms_by_room_id
    filterInputTypeName: hotel_hotel_rooms_filter_input
    aggregate:
      queryRootField: hotel_hotel_rooms_aggregate
      subscription:
        rootField: hotel_hotel_rooms_aggregate
  description: Room inventory for each hotel

---
kind: ModelPermissions
version: v1
definition:
  modelName: hotel_hotel_rooms
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

