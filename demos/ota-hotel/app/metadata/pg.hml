kind: DataConnectorLink
version: v1
definition:
  name: pg
  url:
    readWriteUrls:
      read:
        valueFromEnv: APP_PG_READ_URL
      write:
        valueFromEnv: APP_PG_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: APP_PG_AUTHORIZATION_HEADER
  schema:
    version: v0.2
    schema:
      collections:
        - arguments: {}
          description: Master list of cities
          name: external.cities
          type: external.cities
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - city_id
        - arguments: {}
          description: Local events that may impact hotel demand
          name: external.events
          type: external.events
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - event_id
        - arguments: {}
          description: External factors affecting travel demand
          name: external.external_factors
          type: external.external_factors
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - factor_id
        - arguments: {}
          description: Festivals and celebrations affecting travel patterns
          name: external.festivals
          type: external.festivals
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - festival_id
        - arguments: {}
          description: Room inventory for each hotel
          name: hotel.hotel_rooms
          type: hotel.hotel_rooms
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - room_id
        - arguments: {}
          description: Master table for hotel information
          name: hotel.hotels
          type: hotel.hotels
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - hotel_id
        - arguments: {}
          description: Historical and current pricing data for hotel rooms
          name: hotel.pricing
          type: hotel.pricing
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - pricing_id
        - arguments: {}
          description: Marketing campaign metadata
          name: marketing.campaigns
          type: marketing.campaigns
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - campaign_id
        - arguments: {}
          description: Daily marketing spend and performance metrics
          name: marketing.marketing_spends
          type: marketing.marketing_spends
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - spend_id
        - arguments: {}
          description: Web and app traffic attribution
          name: marketing.traffic_sources
          type: marketing.traffic_sources
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - traffic_id
        - arguments: {}
          description: All hotel bookings made through the platform
          name: user_data.hotel_bookings
          type: user_data.hotel_bookings
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - booking_id
        - arguments: {}
          description: User search behavior tracking
          name: user_data.search_queries
          type: user_data.search_queries
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - query_id
        - arguments: {}
          description: User profile information
          name: user_data.users
          type: user_data.users
          uniqueness_constraints:
            primary_key:
              unique_columns:
                - user_id
      functions: []
      object_types:
        array_set_input:
          description: Wrapper for setting scalar array
          fields:
            value:
              arguments: {}
              description: New value for scalar array
              type:
                type: nullable
                underlying_type:
                  name: array
                  type: named
          foreign_keys: {}
        bigint_set_input:
          description: Wrapper for setting scalar bigint
          fields:
            value:
