  graphql:
    expressionTypeName: hotel_pricing_order_by_exp

---
kind: Model
version: v2
definition:
  name: hotel_pricing
  objectType: hotel_pricing
  source:
    dataConnectorName: pg
    collection: hotel.pricing
  filterExpressionType: hotel_pricing_bool_exp
  aggregateExpression: hotel_pricing_agg_exp
  orderByExpression: hotel_pricing_order_by_exp
  graphql:
    selectMany:
      queryRootField: hotel_pricing
      subscription:
        rootField: hotel_pricing
    selectUniques:
      - queryRootField: hotel_pricing_by_pricing_id
        uniqueIdentifier:
          - pricing_id
        subscription:
          rootField: hotel_pricing_by_pricing_id
    filterInputTypeName: hotel_pricing_filter_input
    aggregate:
