                type: named
            event_type:
              type:
                type: nullable
                underlying_type:
                  name: varchar
                  type: named
            expected_attendance:
              type:
                type: nullable
                underlying_type:
                  name: int4
                  type: named
            updated_at:
              type:
                type: nullable
                underlying_type:
                  name: timestamp
                  type: named
          foreign_keys:
