                name: int4
                type: named
            created_at:
              type:
                type: nullable
                underlying_type:
                  name: timestamp
                  type: named
            end_date:
              type:
                name: date
                type: named
            expected_tourist_influx:
              type:
                type: nullable
                underlying_type:
                  name: int4
                  type: named
            festival_id:
              type:
                name: int4
                type: named
            festival_name:
              type:
                name: varchar
                type: named
            festival_type:
              type:
                type: nullable
                underlying_type:
                  name: varchar
                  type: named
