                type: nullable
                underlying_type:
                  name: int4
                  type: named
            temperature:
              type:
                type: nullable
                underlying_type:
                  name: numeric
                  type: named
            travel_advisory_level:
              type:
                type: nullable
                underlying_type:
                  name: varchar
                  type: named
            updated_at:
              type:
                type: nullable
                underlying_type:
                  name: timestamp
                  type: named
            weather_condition:
              type:
                type: nullable
                underlying_type:
                  name: varchar
                  type: named
          foreign_keys:
            external_factors_city_id_fkey:
