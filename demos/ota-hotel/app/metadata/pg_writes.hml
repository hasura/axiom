kind: DataConnectorLink
version: v1
definition:
  name: pg_writes
  url:
    readWriteUrls:
      read:
        valueFromEnv: APP_PG_WRITES_READ_URL
      write:
        valueFromEnv: APP_PG_WRITES_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: APP_PG_WRITES_AUTHORIZATION_HEADER
  schema:
    version: v0.2
    schema:
      capabilities:
        query:
          aggregates:
            count_scalar_type: int8
      collections:
        - arguments: {}
          description: Master list of cities
          name: external_cities
          type: external_cities
          uniqueness_constraints:
            cities_pkey:
              unique_columns:
                - city_id
        - arguments: {}
          description: Local events that may impact hotel demand
          name: external_events
          type: external_events
          uniqueness_constraints:
            events_pkey:
              unique_columns:
                - event_id
        - arguments: {}
          description: External factors affecting travel demand
          name: external_external_factors
          type: external_external_factors
          uniqueness_constraints:
            external_factors_city_id_date_key:
              unique_columns:
                - city_id
                - date
            external_factors_pkey:
              unique_columns:
                - factor_id
        - arguments: {}
          description: Festivals and celebrations affecting travel patterns
          name: external_festivals
          type: external_festivals
          uniqueness_constraints:
            festivals_pkey:
              unique_columns:
                - festival_id
        - arguments: {}
          name: hdb_catalog_event_invocation_logs
          type: hdb_catalog_event_invocation_logs
          uniqueness_constraints:
            event_invocation_logs_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_event_log
          type: hdb_catalog_event_log
          uniqueness_constraints:
            event_log_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_action_log
          type: hdb_catalog_hdb_action_log
          uniqueness_constraints:
            hdb_action_log_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_cron_event_invocation_logs
          type: hdb_catalog_hdb_cron_event_invocation_logs
          uniqueness_constraints:
            hdb_cron_event_invocation_logs_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_cron_events
          type: hdb_catalog_hdb_cron_events
          uniqueness_constraints:
            hdb_cron_events_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_event_log_cleanups
          type: hdb_catalog_hdb_event_log_cleanups
          uniqueness_constraints:
            hdb_event_log_cleanups_pkey:
              unique_columns:
                - id
            hdb_event_log_cleanups_trigger_name_scheduled_at_key:
              unique_columns:
                - scheduled_at
                - trigger_name
        - arguments: {}
          name: hdb_catalog_hdb_metadata
          type: hdb_catalog_hdb_metadata
          uniqueness_constraints:
            hdb_metadata_pkey:
              unique_columns:
                - id
            hdb_metadata_resource_version_key:
              unique_columns:
                - resource_version
        - arguments: {}
          name: hdb_catalog_hdb_scheduled_event_invocation_logs
          type: hdb_catalog_hdb_scheduled_event_invocation_logs
          uniqueness_constraints:
            hdb_scheduled_event_invocation_logs_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_scheduled_events
          type: hdb_catalog_hdb_scheduled_events
          uniqueness_constraints:
            hdb_scheduled_events_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_schema_notifications
          type: hdb_catalog_hdb_schema_notifications
          uniqueness_constraints:
            hdb_schema_notifications_pkey:
              unique_columns:
                - id
        - arguments: {}
          name: hdb_catalog_hdb_source_catalog_version
          type: hdb_catalog_hdb_source_catalog_version
          uniqueness_constraints: {}
        - arguments: {}
          name: hdb_catalog_hdb_version
          type: hdb_catalog_hdb_version
          uniqueness_constraints:
            hdb_version_pkey:
              unique_columns:
                - hasura_uuid
        - arguments: {}
          description: Room inventory for each hotel
          name: hotel_hotel_rooms
          type: hotel_hotel_rooms
          uniqueness_constraints:
            hotel_rooms_pkey:
              unique_columns:
                - room_id
        - arguments: {}
          description: Master table for hotel information
          name: hotel_hotels
          type: hotel_hotels
          uniqueness_constraints:
            hotels_pkey:
              unique_columns:
                - hotel_id
        - arguments: {}
          description: Historical and current pricing data for hotel rooms
          name: hotel_pricing
          type: hotel_pricing
          uniqueness_constraints:
            pricing_hotel_id_room_id_date_key:
              unique_columns:
                - date
                - hotel_id
                - room_id
            pricing_pkey:
              unique_columns:
                - pricing_id
        - arguments: {}
          description: Marketing campaign metadata
          name: marketing_campaigns
          type: marketing_campaigns
          uniqueness_constraints:
            campaigns_pkey:
              unique_columns:
                - campaign_id
        - arguments: {}
          description: Daily marketing spend and performance metrics
          name: marketing_marketing_spends
          type: marketing_marketing_spends
          uniqueness_constraints:
            marketing_spends_campaign_id_date_key:
              unique_columns:
                - campaign_id
                - date
            marketing_spends_pkey:
              unique_columns:
                - spend_id
        - arguments: {}
          description: Web and app traffic attribution
          name: marketing_traffic_sources
          type: marketing_traffic_sources
          uniqueness_constraints:
            traffic_sources_pkey:
              unique_columns:
                - traffic_id
        - arguments: {}
          description: All hotel bookings made through the platform
          name: user_data_hotel_bookings
          type: user_data_hotel_bookings
          uniqueness_constraints:
            hotel_bookings_pkey:
              unique_columns:
                - booking_id
        - arguments: {}
          description: User search behavior tracking
          name: user_data_search_queries
          type: user_data_search_queries
          uniqueness_constraints:
            search_queries_pkey:
              unique_columns:
                - query_id
        - arguments: {}
          description: User profile information
          name: user_data_users
          type: user_data_users
          uniqueness_constraints:
            users_email_key:
              unique_columns:
                - email
            users_pkey:
              unique_columns:
                - user_id
      functions: []
      object_types:
        delete_external_cities_by_city_id_response:
          description: Responses from the 'delete_external_cities_by_city_id' procedure
          fields:
            affected_rows:
              description: The number of rows affected by the mutation
              type:
                name: int4
                type: named
            returning:
              description: Data from rows affected by the mutation
              type:
                element_type:
                  name: external_cities
                  type: named
                type: array
          foreign_keys: {}
        delete_external_events_by_event_id_response:
          description: Responses from the 'delete_external_events_by_event_id' procedure
          fields:
            affected_rows:
